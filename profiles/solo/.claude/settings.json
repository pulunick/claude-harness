{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'h=$(cat ~/.claude/harness-home 2>/dev/null); [ -n \"$h\" ] && [ -f \"$h/setup/sync.py\" ] && python3 \"$h/setup/sync.py\" --check \"$CLAUDE_PROJECT_DIR\"; exit 0'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "timeout": 10,
            "onFailure": "block",
            "command": "sh -c 'for p in python3 python; do \"$p\" -c \"import sys\" >/dev/null 2>&1 && exec \"$p\" \"$CLAUDE_PROJECT_DIR/tools/harness/pre_gate.py\"; done; echo \"[하네스] python 없음 — pre_gate 를 못 돌려 git 명령을 막음\" >&2; exit 1'"
          }
        ]
      }
    ]
  }
}
