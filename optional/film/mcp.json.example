{
  "mcpServers": {
    "filmcraft": {
      "command": "/bin/zsh",
      "args": [
        "-c",
        "FILMCRAFT_CONTROL_TOKEN=$(<~/.config/artcraft/filmcraft-control-token) exec ~/.local/bin/filmcraft-cli mcp --bridge 127.0.0.1:<film포트>"
      ]
    },
    "effectcraft": {
      "command": "<홈>/.local/bin/effectcraft-cli",
      "args": ["mcp", "--bridge", "<effect포트>"]
    },
    "vectorcraft": {
      "command": "<홈>/.local/bin/vectorcraft-cli",
      "args": ["mcp"]
    },
    "designcraft": {
      "command": "<홈>/.local/bin/designcraft-cli",
      "args": ["mcp", "--automation-read-root", "<프로젝트 절대경로>", "--automation-write-root", "<프로젝트 절대경로>"]
    },
    "photocraft": {
      "command": "<홈>/.local/bin/photocraft-cli",
      "args": ["mcp", "--automation-read-root", "<프로젝트 절대경로>", "--automation-write-root", "<프로젝트 절대경로>"]
    },
    "soundcraft": {
      "command": "<홈>/.local/bin/soundcraft-cli",
      "args": ["mcp", "--automation-read-root", "<프로젝트 절대경로>", "--automation-write-root", "<프로젝트 절대경로>"]
    }
  }
}
